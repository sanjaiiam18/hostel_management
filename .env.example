# Environment Variables for HostelHub

# MongoDB Connection String (leave empty or use 'memory' to use auto-launched in-memory MongoDB in dev/testing)
MONGODB_URI=mongodb://127.0.0.1:27017/hostelhub

# Authentication Secret (at least 32 characters for JOSE HS256)
AUTH_SECRET=hostelhub-production-secure-secret-key-32chars

# Application URL
APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
